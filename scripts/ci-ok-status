#!/usr/bin/env bash
# Print the conclusion of the `CI OK` job of a commit: success, failure, cancelled,
# skipped, `conflict`, or `missing`.
#
#   scripts/ci-ok-status <owner/repo> <sha>
#
# The release guard and `just release` both call this, so they agree on what "CI passed"
# means. It reads the answer from the Test & Build workflow itself (build.yml), not from
# a check that merely carries the name: any integration or workflow able to write checks
# could publish its own `CI OK`.
#
# The commit is tested on the work branch and again on develop, and a run can be re-run,
# so there can be several `CI OK` jobs. The one that completed last decides, wherever it
# is: in another run, or in an earlier attempt of a run that is being re-run right now.
# An earlier success never outvotes a later failure, and a job still in progress is not
# waited for. Two jobs that completed in the same second with different conclusions are
# reported as `conflict`, which is not success.
#
# Needs `gh` (GH_TOKEN with read access to Actions) and `jq`. Exits non-zero only when
# GitHub cannot be asked; a failed or absent job is an answer, printed with exit 0.
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: ${0##*/} <owner/repo> <sha>" >&2
    exit 2
fi
repo=$1
sha=$2
if [[ ! "${sha}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "${0##*/}: '${sha}' is not a full commit SHA" >&2
    exit 2
fi

# Plain assignments, so a failing call fails the script instead of reading as "no runs".
# Runs in every state are listed: a run that is being re-run is "in progress" as a whole
# while its previous attempt already holds a completed, possibly failed, `CI OK`.
runs="$(gh api --paginate \
    "repos/${repo}/actions/workflows/build.yml/runs?head_sha=${sha}&per_page=100" \
    --jq '.workflow_runs[]')"
run_ids="$(jq -rs --arg sha "${sha}" '
    .[] | select(.head_sha == $sha and .path == ".github/workflows/build.yml") | .id' <<<"${runs}")"

jobs=""
for run_id in ${run_ids}; do
    # filter=all: the jobs of every attempt, not only of the latest one.
    run_jobs="$(gh api --paginate \
        "repos/${repo}/actions/runs/${run_id}/jobs?filter=all&per_page=100" --jq '.jobs[]')"
    jobs+="${run_jobs}"$'\n'
done

jq -rs '
    [.[] | select(.name == "CI OK" and .status == "completed" and .completed_at != null)]
    | if length == 0 then "missing"
      else (map(.completed_at) | max) as $latest
        | ([.[] | select(.completed_at == $latest) | .conclusion] | unique) as $verdicts
        | if ($verdicts | length) == 1 then $verdicts[0] else "conflict" end
      end' <<<"${jobs}"
