#!/usr/bin/env bash
# Print the conclusion of the `CI OK` job of a commit: success, failure, cancelled,
# skipped, or `missing`.
#
#   scripts/ci-ok-status <owner/repo> <sha>
#
# The release guard and `just release` both call this, so they agree on what "CI passed"
# means. It reads the answer from the Test & Build workflow itself (build.yml), not from
# a check that merely carries the name: any integration or workflow able to write checks
# could publish its own `CI OK`.
#
# The commit is tested on the work branch and again on develop, so there can be several
# runs. The most recently completed one decides, and an earlier success never outvotes a
# later failure. A run that is still in progress is not waited for.
#
# Needs `gh` (GH_TOKEN with read access to Actions) and `jq`. Exits non-zero only when
# GitHub cannot be asked; a failed or absent job is an answer, printed with exit 0.
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: ${0##*/} <owner/repo> <sha>" >&2
    exit 2
fi
repo=$1
sha=$2
if [[ ! "${sha}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "${0##*/}: '${sha}' is not a full commit SHA" >&2
    exit 2
fi

# A plain assignment, so a failing listing fails the script instead of reading as "no runs".
runs="$(gh api --paginate \
    "repos/${repo}/actions/workflows/build.yml/runs?head_sha=${sha}&status=completed&per_page=100" \
    --jq '.workflow_runs[]')"
run_id="$(jq -rs --arg sha "${sha}" '
    [.[] | select(.head_sha == $sha and .path == ".github/workflows/build.yml")]
    | sort_by(.updated_at) | last | .id // empty' <<<"${runs}")"
if [[ -z "${run_id}" ]]; then
    echo missing
    exit 0
fi

jobs="$(gh api --paginate "repos/${repo}/actions/runs/${run_id}/jobs?filter=latest&per_page=100" \
    --jq '.jobs[]')"
jq -rs '[.[] | select(.name == "CI OK")] | last | .conclusion // "missing"' <<<"${jobs}"
